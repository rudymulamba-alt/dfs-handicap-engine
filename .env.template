# DFS Handicap Engine - Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env to source control.

# Parlay / Odds API
PARLAY_API_KEY=your_parlay_api_key_here
PARLAY_API2=https://api.b365api.com/v1
SPORTSBOOKODDS=sportsbook/odds

# DraftKings
DK_API_KEY=your_dk_api_key_here
DK_API_BASE_URL=https://api.draftkings.com

# ParlayPlay
PP_API_KEY=your_pp_api_key_here
PP_API_BASE_URL=https://api.parlayplay.io

# Chalkboard
CB_API_KEY=your_cb_api_key_here
CB_API_BASE_URL=https://api.chalkboard.io

# Sportradar
SPORTRADAR_API_KEY=your_sportradar_api_key_here

# Database
DATABASE_URL=sqlite:///dfs_engine.db

# Engine settings
ENGINE_BANKROLL=1000.0
ENGINE_MODE=DEEP
ENGINE_LOG_LEVEL=INFO
