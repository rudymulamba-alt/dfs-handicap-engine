# DFS Handicap Engine - Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env to source control.

# ---------------------------------------------------------------------------
# SOLE REQUIRED CREDENTIAL for live odds + props
# ---------------------------------------------------------------------------
# PARLAY_API2 is the Parlay API token. It is the only variable you must set
# to run the model against live data.
PARLAY_API2=your_parlay_api_token_here

# Optional API overrides (defaults are used when these are absent):
#   B365_API_BASE_URL defaults to https://parlay-api.com
#   SPORTSBOOKODDS    defaults to bet365/odds
# B365_API_BASE_URL=https://parlay-api.com
# SPORTSBOOKODDS=v1/bet365/odds
#
# Optional local odds snapshot mode (disabled by default).
# When enabled, the engine loads data/parlay_odds_snapshot.json instead of
# making the live Parlay API odds request.
# PARLAY_ODDS_SNAPSHOT_MODE=true

# ---------------------------------------------------------------------------
# Legacy credential name (kept for backward compatibility — same service as
# PARLAY_API2; only one is needed; PARLAY_API2 takes precedence).
# ---------------------------------------------------------------------------
# PARLAY_API_KEY=your_parlay_api_token_here

# ---------------------------------------------------------------------------
# ParlayAPI (parlay-api.com) — optional second data source
# If absent, this data source is simply skipped.
# ---------------------------------------------------------------------------
# PARLAYAPI_API_KEY=your_parlayapi_key_here
# PARLAY_API_BASE_URL=https://parlay-api.com/v1

# DraftKings
# DK_API_KEY=your_dk_api_key_here
# DK_API_BASE_URL=https://api.draftkings.com

# ParlayPlay
# PP_API_KEY=your_pp_api_key_here
# PP_API_BASE_URL=https://api.parlayplay.io

# Chalkboard
# CB_API_KEY=your_cb_api_key_here
# CB_API_BASE_URL=https://api.chalkboard.io

# Sportradar
# SPORTRADAR_API_KEY=your_sportradar_api_key_here

# Database
DATABASE_URL=sqlite:///dfs_engine.db

# Engine settings
ENGINE_BANKROLL=1000.0
ENGINE_MODE=DEEP
ENGINE_LOG_LEVEL=INFO
